# Sanity Studio environment variables
# Copy this to .env or .env.development and fill in values

# Sanity project credentials
SANITY_STUDIO_PROJECT_ID=kr0ivyaf
SANITY_STUDIO_DATASET=production

# Preview URL — the frontend URL for Presentation tool
# For local dev: http://localhost:3000
# For production: leave unset (uses office.domain from registry)
SANITY_STUDIO_PREVIEW_BASE=http://localhost:3000
