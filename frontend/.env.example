# Next.js frontend environment variables
# Copy this to .env.local and fill in values

# Sanity project credentials (public — exposed to browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=kr0ivyaf
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token (secret — server-side only)
# Required for draft mode / live preview
# Create at: https://www.sanity.io/manage/project/kr0ivyaf/api#tokens
SANITY_API_TOKEN=

# Studio URL for click-to-edit overlays
# For local dev: http://localhost:3333
# For production: your deployed Studio URL
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
